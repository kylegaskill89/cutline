{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutline",
  "version": "0.1.0",
  "identifier": "com.kylegaskill.cutline",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cutline",
        "width": 1040,
        "height": 720,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4QzQxN0IxMjIwOTI3MzkKUldRNUp3a2lzUmZFS0xGUGV3ZDFpUXR4cHlkNXUwK2VXZ0JPdUVjZUJGMkVLZTVSQkgySy9nQzEK",
      "endpoints": [
        "https://github.com/kylegaskill89/cutline/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
